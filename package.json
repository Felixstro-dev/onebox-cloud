{
  "name": "onebox",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted cloud storage in one container.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./jsconfig.json --threshold error",
    "lint": "eslint server web/src",
    "start": "node server/index.js",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/*.test.js",
    "agent": "node agent/bin/onebox-backup.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@node-rs/argon2": "^2.0.2",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-character-count": "^3.32.2",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-table-cell": "^3.32.2",
    "@tiptap/extension-table-header": "^3.32.2",
    "@tiptap/extension-table-row": "^3.32.2",
    "@tiptap/extension-task-item": "^3.32.2",
    "@tiptap/extension-task-list": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "archiver": "^8.0.0",
    "better-sqlite3": "^11.9.1",
    "diff": "^9.0.0",
    "docx": "^9.15.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.44.2",
    "exif-reader": "^2.0.3",
    "fastify": "^5.3.2",
    "file-type": "^22.3.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.34.1",
    "tiptap-markdown": "^0.9.0",
    "turndown": "^7.2.4",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yauzl": "^3.4.0",
    "yjs": "^13.6.33"
