  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "drizzle-kit": "^0.31.1",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.0",
    "jszip": "^3.10.2",
    "lucide-static": "^0.511.0",
    "svelte": "^5.33.1",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "vite": "^6.3.5"
  }
