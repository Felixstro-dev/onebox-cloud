# Kopiere diese Datei nach .env und passe die Werte an. Keine echten Secrets
# ins Repository schreiben.
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
FILES_DIR=./files
BASE_URL=https://cloud.example.com
# Hinter HTTPS auf 1 setzen, damit Session-Cookies das Secure-Flag bekommen.
SECURE_COOKIES=0
TRUST_PROXY=0
SESSION_DAYS=30
# 0 bedeutet unbegrenzt. Empfohlen: ein konkretes Limit setzen.
MAX_UPLOAD_BYTES=0
# Optional: verhindert die Ersteinrichtung durch Dritte.
# SETUP_TOKEN=

# --- Updates ---------------------------------------------------------------
# Installierte Version (muss zum veröffentlichten Git-Tag passen).
ONEB_VERSION=0.1.0
# Interner Updater aus docker-compose.yml. Token mit `openssl rand -hex 24`
# erzeugen; Onebox und Updater müssen denselben Wert verwenden.
UPDATE_API_TOKEN=
# Wartezeit vor dem Neustart in Sekunden (mindestens 30).
UPDATE_DELAY_SECONDS=30
UPDATE_CHECK_REPO=Felixstro-dev/onebox-cloud
